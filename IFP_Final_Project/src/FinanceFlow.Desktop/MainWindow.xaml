<Window x:Class="FinanceFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BarsiG — Digital Banking Simulator"
        Icon="Assets/BarsiG_App_Icon.ico"
        Height="820" Width="1280"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource TitleBarBackgroundBrush}">

    <!--
        The title bar of BarsiG is the bar of the window itself, not the bar of Windows.
        The frame of the window is only used for the resize border and for the shadow,
        the caption of the system is replaced by the bar below.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" x:Name="TitleBarBackgroundBrush" Color="#F4EFE6" />
        <SolidColorBrush x:Key="TitleBarTextBrush" x:Name="TitleBarTextBrush" Color="#18214F" />
        <SolidColorBrush x:Key="TitleBarMutedBrush" x:Name="TitleBarMutedBrush" Color="#656B89" />
        <SolidColorBrush x:Key="TitleBarBorderBrush" x:Name="TitleBarBorderBrush" Color="#DED8CA" />
        <SolidColorBrush x:Key="TitleBarHoverBrush" x:Name="TitleBarHoverBrush" Color="#F1EDE4" />
        <SolidColorBrush x:Key="TitleBarAccentBrush" x:Name="TitleBarAccentBrush" Color="#82602A" />
        <SolidColorBrush x:Key="TitleBarAccentTextBrush" Color="#18214F" />
        <SolidColorBrush x:Key="PopupBackgroundBrush" x:Name="PopupBackgroundBrush" Color="#FBF8F2" />
        <SolidColorBrush x:Key="PopupBorderBrush" x:Name="PopupBorderBrush" Color="#DED8CA" />
        <SolidColorBrush x:Key="StatusOnlineBrush" x:Name="StatusOnlineBrush" Color="#3F8F6B" />
        <SolidColorBrush x:Key="StatusOfflineBrush" x:Name="StatusOfflineBrush" Color="#B4463F" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" x:Name="PanelBackgroundBrush" Color="#F4EFE6" />
        <SolidColorBrush x:Key="PanelTextBrush" x:Name="PanelTextBrush" Color="#18214F" />
        <SolidColorBrush x:Key="PanelMutedBrush" x:Name="PanelMutedBrush" Color="#656B89" />

        <!-- The style of the buttons of the window. They behave like the buttons of Windows. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource TitleBarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B4463F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    <!-- A compact title bar: server status and native window controls, without a duplicate logo. -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Height="38"
              Background="{DynamicResource TitleBarBackgroundBrush}"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                The small button that shows the address of the server.
                The long address is never shown, it is only shown inside the small window.
            -->
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="ServerButton"
                        Width="34" Height="30"
                        Cursor="Hand"
                        Focusable="True"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="Information about the server of BarsiG"
                        AutomationProperties.HelpText="Shows the address of the server and offers to copy it."
                        Click="OnServerButtonClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    CornerRadius="4" SnapsToDevicePixels="True">
                                <Path x:Name="ServerGlyph"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource TitleBarMutedBrush}"
                                      StrokeThickness="1.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 1.5,4.5 A 1.5,1.5 0 0 1 3,3 H 12 A 1.5,1.5 0 0 1 13.5,4.5 V 8.5 A 1.5,1.5 0 0 1 12,10 H 3 A 1.5,1.5 0 0 1 1.5,8.5 Z M 1.5,12.5 A 1.5,1.5 0 0 1 3,11 H 12 A 1.5,1.5 0 0 1 13.5,12.5 V 15.5 A 1.5,1.5 0 0 1 12,17 H 3 A 1.5,1.5 0 0 1 1.5,15.5 Z" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource TitleBarHoverBrush}" />
                                    <Setter TargetName="ServerGlyph" Property="Stroke"
                                            Value="{DynamicResource TitleBarTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource TitleBarHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- The small dot that shows the real state of the server. -->
                <Ellipse x:Name="StatusDot"
                         Width="6" Height="6"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,1,1"
                         IsHitTestVisible="False"
                         Fill="{DynamicResource StatusOfflineBrush}" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        AutomationProperties.Name="Minimize"
                        Click="OnMinimizeClick">
                    <Path Stroke="{DynamicResource TitleBarTextBrush}"
                          StrokeThickness="1"
                          Data="M 0,0 H 10" />
                </Button>

                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        AutomationProperties.Name="Maximize"
                        Click="OnMaximizeClick"
                        MouseRightButtonUp="OnMaximizeButtonMouseRightButtonUp">
                    <Path x:Name="MaximizeGlyph"
                          Stroke="{DynamicResource TitleBarTextBrush}"
                          StrokeThickness="1"
                          Data="M 0.5,0.5 H 10.5 V 10.5 H 0.5 Z" />
                </Button>

                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        AutomationProperties.Name="Close"
                        Click="OnCloseClick">
                    <Path Stroke="{DynamicResource TitleBarTextBrush}"
                          StrokeThickness="1"
                          Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The thin line between the title bar and the interface. It is one pixel high. -->
        <Border Grid.Row="1"
                Height="1"
                Background="{DynamicResource TitleBarBorderBrush}"
                SnapsToDevicePixels="True" />

        <!-- The web interface of BarsiG. -->
        <Grid Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}">
            <wv2:WebView2 x:Name="Browser" />

            <Border x:Name="LoadingPanel"
                    Grid.Row="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/BarsiG_App_Icon_Navy.png" Height="76" Width="76" Margin="0,0,0,14" />
                    <TextBlock Text="BarsiG"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               FontFamily="Georgia"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PanelTextBrush}" />
                    <TextBlock Text="Starting your local banking simulator…"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               Foreground="{DynamicResource PanelTextBrush}" />
                    <TextBlock Text="The local server of the simulator is started inside this window."
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource PanelMutedBrush}" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel"
                    Grid.Row="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Image Source="Assets/BarsiG_App_Icon_Navy.png" Height="76" Width="76" Margin="0,0,0,14" />
                    <TextBlock Text="BarsiG"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"
                               FontFamily="Georgia"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PanelTextBrush}" />
                    <TextBlock Text="The local simulator could not be started"
                               HorizontalAlignment="Center"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PanelTextBrush}" />
                    <TextBlock x:Name="ErrorText"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="13"
                               Foreground="#B4463F" />
                    <Button Content="Try again"
                            Margin="0,18,0,0"
                            Padding="18,8"
                            Cursor="Hand"
                             Background="{DynamicResource TitleBarAccentBrush}"
                             Foreground="{DynamicResource TitleBarAccentTextBrush}"
                            BorderThickness="0"
                            Click="OnRetry" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- The small window that shows the address of the server. -->
        <Popup x:Name="ServerPopup"
           Placement="Bottom"
           PlacementTarget="{Binding ElementName=ServerButton}"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade"
           Focusable="False">
        <Border x:Name="ServerPopupBorder"
                Margin="0,6,0,0"
                Padding="16,14"
                MinWidth="268"
                CornerRadius="8"
                Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#101820" />
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="BarsiG Server"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleBarTextBrush}" />

                <TextBlock x:Name="ServerAddressText"
                           Margin="0,8,0,0"
                           FontFamily="Consolas, Cascadia Mono, Courier New, monospace"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TitleBarMutedBrush}"
                           AutomationProperties.Name="The address of the server of BarsiG" />

                <TextBlock x:Name="ServerStateText"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TitleBarMutedBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CopyAddressButton"
                            Content="Copy address"
                            Padding="14,7"
                            Cursor="Hand"
                             FontSize="12"
                             Background="{DynamicResource TitleBarAccentBrush}"
                             Foreground="{DynamicResource TitleBarAccentTextBrush}"
                            BorderThickness="0"
                            Click="OnCopyAddressClick" />

                    <Button x:Name="OpenInBrowserButton"
                            Content="Open in browser"
                            Margin="8,0,0,0"
                            Padding="14,7"
                            Cursor="Hand"
                            FontSize="12"
                            Background="Transparent"
                            Foreground="{DynamicResource TitleBarTextBrush}"
                            BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1"
                            Click="OnOpenInBrowserClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</Window>
