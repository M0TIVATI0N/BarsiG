    /// <summary>The name of the icon.</summary>
    [Parameter]
    public string Name { get; set; } = "circle";

    /// <summary>Additional CSS classes of the icon.</summary>
    [Parameter]
    public string? CssClass { get; set; }

    private string Path => Icons.TryGetValue(Name, out string? path) ? path : Icons["circle"];

