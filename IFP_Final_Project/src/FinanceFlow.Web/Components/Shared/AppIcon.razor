@*
    A small icon set that is drawn with inline SVG.
    Inline SVG keeps the application free of an external icon library and works offline.
*@

<svg class="icon @CssClass" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="@Path" />
</svg>

