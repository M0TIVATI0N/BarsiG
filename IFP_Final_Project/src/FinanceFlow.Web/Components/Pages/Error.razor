@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong · BarsiG</PageTitle>

<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true">₸</span>
            <span class="brand-name">FinanceFlow</span>
        </div>

        <h1 class="auth-title">Something went wrong</h1>
        <p class="auth-subtitle">
            The request could not be completed. The problem was written to the log of the server.
        </p>

        <div class="editor-actions">
            <a class="btn btn-primary" href="/">Back to the dashboard</a>
        </div>
    </section>
</div>
